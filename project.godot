config_version=5

[application]

config/name="Gatinho Samurai: Ecos Misticos"
config/description="Jogo Metroidvania 2D com tematica asiatica-samurai e misticismo"
run/main_scene="res://scenes/levels/main_level.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/transparent_cats/gato_samurai_1.png"

[display]

